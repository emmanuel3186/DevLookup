{
  "version": 2,
  "rewrites": [
    {
      "source": "/(hero-section.css|profile-card.css)",
      "destination": "/public/$1"
    },
    {
      "source": "/assets/:path*",
      "destination": "/public/assets/:path*"
    },
    {
      "source": "/((?!public/).*)",
      "destination": "/server.js"
    }
  ]
}
